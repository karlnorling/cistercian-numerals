{
  "name": "@cistercian/cli",
  "version": "0.2.0",
  "description": "Command line tool that draws numbers as Cistercian numerals: SVG, PNG, JPEG or WebP",
  "keywords": [
    "cistercian",
    "cistercian-numerals",
    "cli",
    "jpeg",
    "numerals",
    "png",
    "svg",
    "webp"
  ],
  "homepage": "https://karlnorling.github.io/cistercian-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/cistercian-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/cistercian-numerals.git",
    "directory": "packages/@cistercian/cli"
  },
  "bin": {
    "cistercian": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@cistercian/core": "workspace:^",
    "@cistercian/raster": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
